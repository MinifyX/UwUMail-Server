# Public name of your mail server. Needs an A/AAAA record pointing to this machine.
UWUMAIL_HOSTNAME=mail.example.com

# Let's Encrypt sends certificate expiry warnings here (optional).
UWUMAIL_ACME_EMAIL=

# Language of bounce messages and other mail the server writes: de or en.
UWUMAIL_LANGUAGE=de

# Image tag: edge (newest build of main) or a release like 0.1.0.
UWUMAIL_VERSION=edge

# Public name of your mail server. Needs an A/AAAA record pointing to this machine, or to the
# UwUMail Gateway when the server runs at home behind one.
UWUMAIL_HOSTNAME=mail.example.com

# Let's Encrypt sends certificate expiry warnings here (optional).
UWUMAIL_ACME_EMAIL=

# Language of bounce messages and other mail the server writes: de or en.
UWUMAIL_LANGUAGE=de

# Image tag: latest (stable releases), beta (every release), edge (every commit on main)
# or an exact version like 0.1.0.
UWUMAIL_VERSION=latest

# Pairing code of your UwUMail Gateway (uwugw1...), only for a server at home behind a gateway.
# The server then pairs when it starts, and the web address works through the gateway right away.
UWUMAIL_GATEWAY_CODE=

# Where UwUMail listens on this machine, for when something else already holds one of its ports.
# A port, or an address:port. install.sh looks before it starts and asks about every port it
# finds taken, so these lines are usually already right.
#
# The web ones are the usual case: another web server (Caddy, Traefik, nginx) on 80 and 443.
# Behind a gateway nothing else is needed for them, the web arrives through the tunnel.
#UWUMAIL_HTTP_BIND=127.0.0.1:8081
#UWUMAIL_HTTPS_BIND=8443
#
# The mail ports move the same way. Only where UwUMail listens moves: from the outside the
# numbers stay, because other mail servers only ever try 25 and mail apps expect 465, 587 and
# 993, so the router or the firewall in front has to send those numbers here. Behind a gateway
# nothing arrives on them from outside at all; there they are only for mail apps at home.
#UWUMAIL_SMTP_BIND=1025          # 25, mail from other servers
#UWUMAIL_SUBMISSIONS_BIND=1465   # 465, mail apps sending over TLS
#UWUMAIL_SUBMISSION_BIND=1587    # 587, mail apps sending with STARTTLS
#UWUMAIL_IMAPS_BIND=1993         # 993, mail apps reading

# The virus scanner is a service in compose.yaml behind a profile. install.sh and update.sh put
# the line below here for you unless you said no; with it, the scanner comes along with every
# up -d. By hand it is:
#   docker compose --profile antivirus up -d
#   docker compose exec uwumail uwumail-server settings set spam.antivirus.enabled true
# It wants about 1 GB of memory (plan for 2). See docs/antivirus.md.
#COMPOSE_PROFILES=antivirus

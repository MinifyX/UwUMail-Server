# The VPN the remote pictures in messages are fetched through (gluetun, the `vpn` profile in
# compose.yaml). Copy this file to .env.vpn and keep one of the blocks below. Every provider and
# setting: https://github.com/qdm12/gluetun-wiki
#
# Then, in .env:
#   UWUMAIL_EGRESS_PROXY=http://gluetun:8888
#   UWUMAIL_EGRESS_FALLBACK=block     # or direct: fetch from the server while the VPN is down

# NordVPN with WireGuard (NordLynx). The private key is under "Manual setup" in your NordVPN account.
VPN_SERVICE_PROVIDER=nordvpn
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=your-private-key
SERVER_COUNTRIES=Switzerland

# NordVPN with OpenVPN. The service credentials from "Manual setup", not your login.
#VPN_SERVICE_PROVIDER=nordvpn
#VPN_TYPE=openvpn
#OPENVPN_USER=service-username
#OPENVPN_PASSWORD=service-password
#SERVER_COUNTRIES=Switzerland

# Any WireGuard server, from the values of its .conf file. The endpoint has to be an IP address.
#VPN_SERVICE_PROVIDER=custom
#VPN_TYPE=wireguard
#WIREGUARD_ENDPOINT_IP=203.0.113.10
#WIREGUARD_ENDPOINT_PORT=51820
#WIREGUARD_PUBLIC_KEY=server-public-key
#WIREGUARD_PRIVATE_KEY=your-private-key
#WIREGUARD_ADDRESSES=10.64.0.2/32

# Any OpenVPN server, from its .ovpn file. Mount the file into the container in compose.yaml
# (volumes: - ./vpn.ovpn:/gluetun/custom.ovpn:ro).
#VPN_SERVICE_PROVIDER=custom
#VPN_TYPE=openvpn
#OPENVPN_CUSTOM_CONFIG=/gluetun/custom.ovpn
#OPENVPN_USER=username
#OPENVPN_PASSWORD=password

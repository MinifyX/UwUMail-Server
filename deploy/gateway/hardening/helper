#!/usr/bin/env bash
# The part of the UwUMail Gateway installation that needs root. The gateway itself has none: its
# systemd unit leaves it nothing but the low ports, so it can neither ask apt what is missing nor
# ban anyone. The two meet in the gateway's state directory, through plain files:
#
#   trusted      written by the gateway   the address its tunnel comes from, and nothing else
#   bans.jsonl   written by the gateway   bans it was asked for, one JSON object per line
#   jobs.jsonl   written by the gateway   what the portal asked this machine to do
#   machine.json written here             what apt, ufw and fail2ban have to say
#   job-<id>.log written here             what a job printed, while it runs
#   job-<id>.json written here            how it ended, which survives the gateway restarting
#
# What only this side reads lives in a directory of its own that the gateway cannot write:
#
#   ignoring     what fail2ban was last told to leave alone
#
# `trusted` holds the address in use and no history: the one a home connection gives up at the
# nightly reconnect goes to the next customer, so anything older is not the server's to vouch for.
# Every run takes back what fail2ban was told before and is no longer trusted.
#
# Nothing the gateway writes is ever run as a command here: addresses are checked against a strict
# pattern, and the only thing that reaches fail2ban is an address that passed it.
#
# The gateway owns its state directory, so it can put a symlink wherever a name is. Nothing here
# therefore touches a name there after creating it: a file is made fresh with its final mode and
# renamed into place (a rename replaces a symlink, it never follows one), and a job's log is opened
# once and written through that descriptor (security-audit-0.5.2 G-5, security-audit-0.8.0 INF-3).
#
#   helper tick            keep the trusted addresses safe and carry out waiting bans
#   helper machine         write machine.json (slow: asks apt)
#   helper task            carry out what the portal asked for: updates, a restart, a new gateway
#   helper ignore <ip>     for fail2ban's ignorecommand: 0 when the address must never be banned
#   helper report [--motd] what all of this looks like right now, for people
set -uo pipefail
# Everything this writes for the gateway is meant to be read by it, and is created that way.
umask 022

# Where this keeps things. Both can be moved for a test on a machine one has no root on; the
# systemd units set no environment, so in service they are always the paths below.
state="${UWUMAIL_GATEWAY_STATE:-/var/lib/uwumail-gateway}"
private="${UWUMAIL_GATEWAY_PRIVATE:-/var/lib/uwumail-gateway-helper}"
trusted_file="$state/trusted"
bans_file="$state/bans.jsonl"
jobs_file="$state/jobs.jsonl"
report_file="$state/machine.json"
# What we last told fail2ban to ignore, so it can be taken back when it stops being the server's.
ignoring_file="$private/ignoring"
# Where versions before 0.8.0 kept it, in the gateway's own directory.
old_ignoring_file="$state/ignoring"
# The jail that only ever holds what the UwUMail server asked for.
jail=uwumail-server

# ── what the portal may ask for ───────────────────────────────────────────────────────────────
# Three words, and nothing else is ever carried out. The address a new gateway is fetched from is
# built here out of these constants and a version number that had to look like one -- never out of
# anything the server sent. A server somebody broke into must not be able to hand this VPS a URL.
verbs="os-update reboot gateway-update"
releases=https://github.com/MinifyX/UwUMail-Server/releases/download
# A job that waited longer than this was asked for by a portal that has long given up.
JOB_MAX_AGE=1800
# The most of a job's output that is kept, so a chatty apt cannot fill the disk.
LOG_MAX_BYTES=65536

# An address as the gateway writes it, and nothing else. Everything downstream trusts this check.
is_address() {
  [[ "${1:-}" =~ ^[0-9a-fA-F:.]{3,45}$ ]] || return 1
  # Let the system have the last word on what is an address; the pattern only keeps shell
  # metacharacters and anything else surprising away from it.
  ip -o route get "$1" >/dev/null 2>&1 || [[ "$1" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || [[ "$1" == *:* ]]
}

# The addresses that must never be banned: where the tunnel comes from. Each line of the file is
# "<address> <unix time> <range>"; the gateway keeps it current and drops old entries itself.
trusted_addresses() {
  [ -f "$trusted_file" ] || return 0
  awk '{ print $1 }' "$trusted_file" 2>/dev/null | while read -r address; do
    is_address "$address" && printf '%s\n' "$address"
  done
}

# The same, as ranges: a single address for IPv4, the whole /64 for IPv6, because a home connection
# owns that /64 and the server moves around inside it. fail2ban is given these to match itself —
# comparing address text in a shell script would get IPv6 wrong sooner or later.
trusted_ranges() {
  [ -f "$trusted_file" ] || return 0
  awk '{ print $3 }' "$trusted_file" 2>/dev/null | while read -r range; do
    # A home connection owns exactly one IPv4 address or one IPv6 /64; nothing wider is ever
    # trusted, so a crafted line such as 0.0.0.0/0 or ::/0 cannot switch a jail's protection off
    # for the whole internet (security-audit-0.5.2 G-3).
    case "$range" in
      */32) [[ "$range" =~ ^[0-9.]{7,15}/32$ ]] && printf '%s\n' "$range" ;;
      *:*/64) [[ "$range" =~ ^[0-9a-fA-F:]{2,45}/64$ ]] && printf '%s\n' "$range" ;;
    esac
  done
}

# Tells every jail which ranges it must leave alone — and, just as importantly, takes back the ones
# that are no longer the server's.
#
# A home connection is handed a different address every night, and the one it gives up goes to the
# next customer. If yesterday's range stayed in fail2ban's ignore list, that stranger would be
# unbannable for as long as it sat there. So what was set last time is written down, and whatever
# is no longer trusted is removed before the current one is added.
#
# fail2ban also forgets all of this when it restarts, which is why the timer beside this sets it
# again every couple of minutes.
keep_the_trusted_out_of_jails() {
  command -v fail2ban-client >/dev/null 2>&1 || return 0
  fail2ban-client ping >/dev/null 2>&1 || return 0
  local jails
  jails=$(fail2ban-client status 2>/dev/null | sed -n 's/.*Jail list:\s*//p' | tr -d ' ' | tr ',' ' ')
  [ -n "$jails" ] || return 0

  local now before range one
  now=$(trusted_ranges | sort -u)

  # Take back everything we told fail2ban before that is not trusted any more. The list an older
  # version left in the gateway's directory is read once more, only for what it names, and goes.
  install -d -m 0700 "$private" || return 1
  local list
  for list in "$ignoring_file" "$old_ignoring_file"; do
    [ -f "$list" ] || continue
    while read -r before; do
      [[ "$before" =~ ^[0-9a-fA-F:.]{3,45}/[0-9]{1,3}$ ]] || continue
      printf '%s\n' "$now" | grep -qxF "$before" && continue
      for one in $jails; do
        fail2ban-client set "$one" delignoreip "$before" >/dev/null 2>&1
      done
      logger -t uwumail-gateway "stopped trusting $before: the UwUMail server does not connect from it any more"
    done <"$list"
  done
  rm -f -- "$old_ignoring_file"

  while read -r range; do
    [ -n "$range" ] || continue
    for one in $jails; do
      fail2ban-client set "$one" addignoreip "$range" >/dev/null 2>&1
    done
  done <<<"$now"

  # Only now, so a run that dies halfway leaves something to clean up rather than nothing.
  printf '%s\n' "$now" | safe_write "$ignoring_file"
}

own_addresses() {
  ip -o addr show scope global 2>/dev/null | awk '{ print $4 }' | cut -d/ -f1
}

# helper ignore <ip> — fail2ban asks before every ban; 0 means "leave this one alone".
cmd_ignore() {
  local candidate="${1:-}"
  is_address "$candidate" || return 1
  local address
  while read -r address; do
    [ "$address" = "$candidate" ] && return 0
  done < <(trusted_addresses)
  return 1
}

# Takes back a ban that reached an address it never should have. The gateway keeps its trusted
# list current, so this is what catches an address that was banned before the tunnel moved to it —
# the realistic case behind carrier-grade NAT, where the neighbours share the address.
free_the_trusted() {
  command -v fail2ban-client >/dev/null 2>&1 || return 0
  fail2ban-client ping >/dev/null 2>&1 || return 0
  local jails address
  jails=$(fail2ban-client status 2>/dev/null | sed -n 's/.*Jail list:\s*//p' | tr -d ' ' | tr ',' ' ')
  [ -n "$jails" ] || return 0
  while read -r address; do
    for one in $jails; do
      if fail2ban-client get "$one" banned "$address" 2>/dev/null | grep -q '^1$'; then
        fail2ban-client set "$one" unbanip "$address" >/dev/null 2>&1 &&
          logger -t uwumail-gateway "freed $address from $one: the UwUMail server connects from it"
      fi
    done
  done < <(trusted_addresses)
}

# Hands the bans the server asked for to fail2ban. The file is carried off first, so the gateway
# can keep appending to a fresh one while this runs.
carry_out_bans() {
  [ -s "$bans_file" ] || return 0
  command -v fail2ban-client >/dev/null 2>&1 || return 0
  fail2ban-client ping >/dev/null 2>&1 || return 0
  fail2ban-client status "$jail" >/dev/null 2>&1 || return 0

  local waiting="$bans_file.now"
  mv -fT "$bans_file" "$waiting" 2>/dev/null || return 0

  local line action address seconds reason
  while IFS= read -r line; do
    action=$(printf '%s' "$line" | jq -r '.action // empty' 2>/dev/null) || continue
    address=$(printf '%s' "$line" | jq -r '.ip // empty' 2>/dev/null) || continue
    is_address "$address" || continue
    # The gateway checks this too. Checked again here because this side has the rights.
    if cmd_ignore "$address"; then
      logger -t uwumail-gateway "refused to ban $address: the UwUMail server connects from it"
      continue
    fi
    case "$action" in
      ban)
        seconds=$(printf '%s' "$line" | jq -r '.seconds // 3600' 2>/dev/null)
        [[ "$seconds" =~ ^[0-9]{1,7}$ ]] || seconds=3600
        reason=$(printf '%s' "$line" | jq -r '.reason // ""' 2>/dev/null | tr -cd '[:alnum:] ._-' | cut -c1-60)
        if fail2ban-client set "$jail" banip "$address" >/dev/null 2>&1; then
          logger -t uwumail-gateway "banned $address for ${seconds}s, asked by the UwUMail server: ${reason:-no reason}"
        fi
        ;;
      unban) fail2ban-client set "$jail" unbanip "$address" >/dev/null 2>&1 &&
        logger -t uwumail-gateway "let $address in again, asked by the UwUMail server" ;;
    esac
  done <"$waiting"
  rm -f "$waiting"
}

cmd_tick() {
  keep_the_trusted_out_of_jails
  free_the_trusted
  carry_out_bans
}

# How many updates wait, and whether any of them is a security update. Ubuntu ships apt-check for
# exactly this; the fallback keeps the report useful on a machine without update-notifier.
count_updates() {
  local all=0 security=0
  if [ -x /usr/lib/update-notifier/apt-check ]; then
    local counted
    counted=$(/usr/lib/update-notifier/apt-check 2>&1)
    all=${counted%%;*}
    security=${counted##*;}
  else
    all=$(apt-get -s -o Debug::NoLocking=true dist-upgrade 2>/dev/null | grep -c '^Inst ')
    security=$(apt-get -s -o Debug::NoLocking=true dist-upgrade 2>/dev/null | grep '^Inst ' | grep -ci security)
  fi
  [[ "$all" =~ ^[0-9]+$ ]] || all=0
  [[ "$security" =~ ^[0-9]+$ ]] || security=0
  printf '%s %s\n' "$all" "$security"
}

# Whether security updates install themselves. Both switches have to be on for it to happen.
automatic_security() {
  local settings
  settings=$(apt-config dump 2>/dev/null) || return 1
  grep -q 'APT::Periodic::Update-Package-Lists "1"' <<<"$settings" &&
    grep -q 'APT::Periodic::Unattended-Upgrade "1"' <<<"$settings" &&
    systemctl is-enabled unattended-upgrades >/dev/null 2>&1
}

# ── jobs ──────────────────────────────────────────────────────────────────────────────────────
# A version as we are willing to read one. Nothing else ever reaches a command line or a URL.
is_version() {
  [[ "${1:-}" =~ ^[0-9]{1,4}\.[0-9]{1,4}\.[0-9]{1,4}(-[0-9A-Za-z.]{1,20})?$ ]]
}


# Whether going to $1 from $2 would be going backwards.
#
# The portal only ever offers something newer, but the portal runs in the container -- the side this
# helper exists to distrust. An old image is an old set of holes, so a server somebody took over
# must not be able to ask for one and walk back in through it. When either side is not a version
# (a tag like `latest`), there is nothing to compare and the update is allowed.
is_older() {
  local want="${1:-}" have="${2:-}"
  is_version "$want" && is_version "$have" || return 1
  [ "$want" = "$have" ] && return 1
  [ "$(printf '%s\n%s\n' "$want" "$have" | sort -V | head -1)" = "$want" ]
}

# Writes standard input to a file without following a symlink the gateway user may have planted in
# its own state directory. The name is cleared first (removing a symlink, not its target), then
# opened with noclobber (O_EXCL), so a symlink re-planted in the meantime makes the write fail
# rather than let root reach through it to an arbitrary file (security-audit-0.5.2 G-5).
safe_write() {
  local target="$1"
  rm -f -- "$target"
  ( set -C; cat >"$target" )
}

# Made with its final mode and renamed into place. Nothing touches the name afterwards: a chmod
# would follow a symlink put there in the meantime (security-audit-0.8.0 INF-3).
job_state() {
  local id="$1" how="$2" error="${3:-}"
  jq -n --arg id "$id" --arg state "$how" --arg error "$error" --argjson at "$(date +%s)" \
    '{id: $id, state: $state, error: $error, at: $at}' 2>/dev/null | safe_write "$state/job-$id.json.tmp" &&
    mv -fT "$state/job-$id.json.tmp" "$state/job-$id.json"
}

# Everything a job prints goes here, capped, so the portal can show it while it runs. The log is
# opened once, by run_job, and only ever written through that descriptor (3), never by its name.
job_log() {
  tail -c "$LOG_MAX_BYTES" >&3
}

# Carries out one job with its log open on descriptor 3: made fresh with noclobber, so a name
# re-planted after the rm makes the job fail rather than write through it.
run_job() {
  local id="$1" verb="$2" version="$3"
  local log="$state/job-$id.log" started=false
  rm -f -- "$log"
  set -C
  {
    set +C
    started=true
    case "$verb" in
      os-update) do_os_update "$id" ;;
      reboot) do_reboot "$id" ;;
      gateway-update) do_gateway_update "$id" "$version" ;;
    esac
  } 3>"$log"
  set +C
  $started || job_state "$id" failed "the job's log could not be started"
}

# apt with every question answered the way the package maintainer meant it. NEEDRESTART_MODE=a is
# the one that matters on Ubuntu 24.04 and newer: without it the run stops on a full-screen
# question nobody is there to answer.
run_apt() {
  DEBIAN_FRONTEND=noninteractive \
    NEEDRESTART_MODE=a \
    APT_LISTCHANGES_FRONTEND=none \
    apt-get -y \
    -o Dpkg::Options::=--force-confdef \
    -o Dpkg::Options::=--force-confold \
    -o DPkg::Lock::Timeout=300 \
    "$@"
}

do_os_update() {
  local id="$1"
  command -v apt-get >/dev/null 2>&1 || {
    job_state "$id" failed "this machine is not one apt can update"
    return 1
  }
  {
    printf '== apt-get update\n'
    run_apt update
    printf '\n== apt-get dist-upgrade\n'
    run_apt dist-upgrade
    printf '\n== apt-get autoremove\n'
    run_apt --purge autoremove
  } 2>&1 | job_log "$id"
  local result=${PIPESTATUS[0]}
  cmd_machine
  if [ "$result" -eq 0 ]; then
    job_state "$id" "done"
  else
    job_state "$id" failed "apt ended with $result"
  fi
}

do_reboot() {
  local id="$1"
  job_state "$id" "done"
  printf 'the machine restarts in a minute\n' | job_log "$id"
  # A minute, so the answer still reaches the server and mail in flight has a moment to finish.
  shutdown -r +1 "UwUMail Gateway: restart from the portal" >/dev/null 2>&1 &
}

# Fetches the gateway of a given version, checks it against the checksum published beside it, and
# lets install.sh put it in place. The old binary is kept until the new one is up.
do_gateway_update() {
  local id="$1" version="$2"
  local architecture file work
  architecture=$(dpkg --print-architecture 2>/dev/null || uname -m)
  if [ "$architecture" != "amd64" ] && [ "$architecture" != "x86_64" ]; then
    job_state "$id" failed "there is no published gateway for $architecture; update it by hand"
    return 1
  fi
  local running
  running=$(/usr/local/bin/uwumail-gateway --version 2>/dev/null | tr ' ' '\n' | grep -m1 -E '^[0-9]+\.[0-9]+\.[0-9]+')
  if is_older "$version" "$running"; then
    job_state "$id" failed "$version is older than $running; this helper does not go backwards"
    return 1
  fi
  file=uwumail-gateway-linux-amd64.tar.gz
  work=$(mktemp -d) || {
    job_state "$id" failed "could not make a working directory"
    return 1
  }

  local result=0
  {
    printf '== fetching uwumail-gateway %s\n' "$version"
    curl -fsSL --retry 3 --max-time 300 -o "$work/$file" "$releases/v$version/$file" &&
      curl -fsSL --retry 3 --max-time 60 -o "$work/$file.sha256" "$releases/v$version/$file.sha256" || exit 1
    printf '\n== checking the checksum\n'
    (cd "$work" && sha256sum -c "$file.sha256") || exit 1
    printf '\n== unpacking\n'
    tar -xzf "$work/$file" -C "$work" || exit 1
    [ -x "$work/uwumail-gateway/uwumail-gateway" ] || exit 1
    printf '\n== keeping the gateway that runs now\n'
    cp -a /usr/local/bin/uwumail-gateway "$work/before" 2>/dev/null || true
    printf '\n== install.sh\n'
    bash "$work/uwumail-gateway/install.sh" "$work/uwumail-gateway/uwumail-gateway" || exit 1
  } 2>&1 | job_log "$id"
  result=${PIPESTATUS[0]}

  if [ "$result" -ne 0 ]; then
    rm -rf "$work"
    job_state "$id" failed "the update ended with $result"
    return 1
  fi

  # Wait for it to come back. install.sh restarts the service itself; this only checks that what
  # came up is actually running and speaking.
  local waited=0
  while [ "$waited" -lt 60 ]; do
    systemctl is-active --quiet uwumail-gateway && break
    sleep 3
    waited=$((waited + 3))
  done
  if systemctl is-active --quiet uwumail-gateway; then
    printf '\nuwumail-gateway is running again\n' | job_log "$id"
    rm -rf "$work"
    cmd_machine
    job_state "$id" "done"
    return 0
  fi

  # It did not come up. Put back the binary that did, which is the only thing that changed.
  {
    printf '\n== the new gateway did not come up, putting the old one back\n'
    journalctl -u uwumail-gateway -n 30 --no-pager 2>/dev/null
    if [ -x "$work/before" ]; then
      install -m 0755 "$work/before" /usr/local/bin/uwumail-gateway
      systemctl restart uwumail-gateway
    fi
  } 2>&1 | job_log "$id"
  rm -rf "$work"
  cmd_machine
  job_state "$id" failed "the new gateway did not come up; the one before is running again"
  return 1
}

# helper task — what the gateway wrote into jobs.jsonl, one line at a time.
cmd_task() {
  [ -s "$jobs_file" ] || return 0

  # A gateway update runs install.sh, and install.sh writes a new helper over this very file.
  # Bash reads a script from disk as it goes, so the rest of this one would turn into whatever
  # landed at the same offset. The work therefore happens in a copy that nobody is going to touch.
  if [ "${UWUMAIL_HELPER_COPY:-}" != "1" ]; then
    local copy result
    copy=$(mktemp) || return 1
    cp "$0" "$copy" && chmod 0700 "$copy" || {
      rm -f "$copy"
      return 1
    }
    UWUMAIL_HELPER_COPY=1 bash "$copy" task
    result=$?
    rm -f "$copy"
    return $result
  fi

  local waiting="$jobs_file.now"
  mv -fT "$jobs_file" "$waiting" 2>/dev/null || return 0

  local line id verb version asked now
  now=$(date +%s)
  while IFS= read -r line; do
    id=$(printf '%s' "$line" | jq -r '.id // empty' 2>/dev/null)
    verb=$(printf '%s' "$line" | jq -r '.verb // empty' 2>/dev/null)
    version=$(printf '%s' "$line" | jq -r '.version // empty' 2>/dev/null)
    asked=$(printf '%s' "$line" | jq -r '.at // 0' 2>/dev/null)
    # An id names a file, so it may be nothing but letters and digits.
    [[ "$id" =~ ^[A-Za-z0-9]{4,40}$ ]] || continue
    case " $verbs " in *" $verb "*) ;; *)
      job_state "$id" failed "this helper does not do $verb"
      continue
      ;;
    esac
    [[ "$asked" =~ ^[0-9]{1,12}$ ]] || asked=0
    if [ "$asked" -gt 0 ] && [ $((now - asked)) -gt "$JOB_MAX_AGE" ]; then
      job_state "$id" failed "the job waited too long; ask again"
      continue
    fi
    if [ -n "$version" ] && ! is_version "$version"; then
      job_state "$id" failed "that is not a version number"
      continue
    fi
    if [ "$verb" = "gateway-update" ] && [ -z "$version" ]; then
      job_state "$id" failed "no version was named"
      continue
    fi
    [ -e "$state/job-$id.json" ] && continue # already done, or being done

    job_state "$id" running
    run_job "$id" "$verb" "$version"
  done <"$waiting"
  rm -f "$waiting"

  # Jobs nobody will ask about again.
  find "$state" -maxdepth 1 -name 'job-*' -mtime +7 -delete 2>/dev/null
}

cmd_machine() {
  # Only the package lists, never an install: what gets installed stays the operator's decision,
  # apart from the security updates unattended-upgrades handles on its own.
  apt-get update -qq >/dev/null 2>&1

  local updates security name reboot release
  read -r updates security < <(count_updates)
  name=$(. /etc/os-release 2>/dev/null && printf '%s' "${PRETTY_NAME:-Linux}")
  reboot=false
  [ -f /var/run/reboot-required ] && reboot=true
  release=$(do-release-upgrade -c 2>/dev/null | sed -n 's/^New release \x27\(.*\)\x27 available.*/\1/p' | head -1)

  local automatic=false
  automatic_security && automatic=true

  # The firewall and fail2ban, as they are right now.
  local firewall="" firewall_active=false fail2ban=false banned=0 from_server=0 jails="[]"
  if command -v ufw >/dev/null 2>&1; then
    firewall=ufw
    # The whole word: "Status: inactive" contains "active", and reporting a firewall that is off
    # as running would be worse than saying nothing at all.
    ufw status 2>/dev/null | head -1 | grep -q '^Status: active$' && firewall_active=true
  elif command -v nft >/dev/null 2>&1 && nft list ruleset 2>/dev/null | grep -q 'hook input'; then
    firewall=nftables
    firewall_active=true
  fi
  if command -v fail2ban-client >/dev/null 2>&1 && fail2ban-client ping >/dev/null 2>&1; then
    fail2ban=true
    local names
    names=$(fail2ban-client status 2>/dev/null | sed -n 's/.*Jail list:\s*//p' | tr -d ' ' | tr ',' ' ')
    jails=$(printf '%s' "$names" | tr ' ' '\n' | grep -v '^$' | jq -R . | jq -s -c . 2>/dev/null || printf '[]')
    for one in $names; do
      local count
      count=$(fail2ban-client status "$one" 2>/dev/null | sed -n 's/.*Currently banned:\s*//p' | head -1)
      [[ "$count" =~ ^[0-9]+$ ]] || count=0
      banned=$((banned + count))
      [ "$one" = "$jail" ] && from_server=$count
    done
  fi

  local command="apt-get update && apt-get -y dist-upgrade"
  [ "$reboot" = true ] && command="$command && reboot"

  # Written through a temporary file: the gateway reads this while it is being replaced. Made with
  # its final mode and renamed, and never touched by name after that.
  local temporary="$report_file.tmp"
  jq -n \
    --argjson writtenAt "$(date +%s)" \
    --arg name "$name" \
    --argjson updates "$updates" \
    --argjson security "$security" \
    --argjson reboot "$reboot" \
    --argjson automatic "$automatic" \
    --arg release "$release" \
    --arg command "$command" \
    --arg firewall "$firewall" \
    --argjson firewallActive "$firewall_active" \
    --argjson fail2ban "$fail2ban" \
    --argjson banned "$banned" \
    --argjson fromServer "$from_server" \
    --argjson jails "$jails" \
    '{
      writtenAt: $writtenAt,
      system: {
        name: $name, updates: $updates, securityUpdates: $security, rebootRequired: $reboot,
        automaticSecurity: $automatic, newRelease: (if $release == "" then null else $release end),
        command: $command
      },
      protection: {
        firewall: $firewall, firewallActive: $firewallActive, fail2ban: $fail2ban,
        banned: $banned, jails: $jails, fromServer: $fromServer
      }
    }' 2>/dev/null | safe_write "$temporary" || return 1
  mv -fT "$temporary" "$report_file"
}

# helper report — the same thing for people. --motd keeps it to the few lines worth seeing on login.
cmd_report() {
  local motd=false
  [ "${1:-}" = "--motd" ] && motd=true
  [ -f "$report_file" ] || { $motd || echo "No report yet. Run: uwumail-gateway-helper machine"; return 0; }

  local name updates security reboot automatic release command
  # Strip control bytes from anything the report carries, so a crafted machine.json cannot inject
  # terminal escape sequences into the root login banner (security-audit-0.5.2 G-4).
  name=$(jq -r '.system.name // "Linux"' "$report_file" | tr -d '[:cntrl:]')
  updates=$(jq -r '.system.updates // 0' "$report_file")
  security=$(jq -r '.system.securityUpdates // 0' "$report_file")
  reboot=$(jq -r '.system.rebootRequired // false' "$report_file")
  automatic=$(jq -r '.system.automaticSecurity // false' "$report_file")
  release=$(jq -r '.system.newRelease // ""' "$report_file" | tr -d '[:cntrl:]')
  # The command to run is this script's own constant, never a string the report chose: a compromised
  # gateway must not be able to put a command in front of the admin as root-to-run (G-4).
  command="apt-get update && apt-get -y dist-upgrade"
  [ "$reboot" = true ] && command="$command && reboot"

  if $motd && [ "$updates" = 0 ] && [ "$reboot" != true ] && [ -z "$release" ]; then
    return 0
  fi

  printf '\n  (=^-w-^=)  UwUMail Gateway  ·  %s\n' "$name"
  if [ "$updates" = 0 ]; then
    printf '  Everything is up to date.\n'
  elif [ "$security" = 0 ]; then
    printf '  %s updates wait, none of them a security update.\n' "$updates"
  else
    printf '  %s updates wait, %s of them security updates.\n' "$updates" "$security"
  fi
  [ "$automatic" = true ] && printf '  Security updates install themselves.\n'
  [ "$reboot" = true ] && printf '  A restart is needed. Mail senders get "try again later" while it runs.\n'
  [ -n "$release" ] && printf '  A newer version of the system waits: %s (do-release-upgrade)\n' "$release"
  [ "$updates" = 0 ] || printf '  Install them with:  %s\n' "$command"
  printf '\n'
}

# Sourced by deploy/tests/helpers.sh, which calls the functions above on a directory of its own.
[ "${BASH_SOURCE[0]}" = "$0" ] || return 0

case "${1:-}" in
  tick) cmd_tick ;;
  machine) cmd_machine ;;
  task) cmd_task ;;
  ignore) cmd_ignore "${2:-}" ;;
  report) cmd_report "${2:-}" ;;
  *)
    echo "usage: ${0##*/} tick | machine | task | ignore <ip> | report [--motd]" >&2
    exit 2
    ;;
esac

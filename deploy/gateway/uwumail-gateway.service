# UwUMail Gateway as a systemd service. deploy/gateway/install.sh puts it into place.
[Unit]
Description=UwUMail Gateway
Documentation=https://github.com/MinifyX/UwUMail-Server/blob/main/docs/gateway.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=uwumail-gateway
Group=uwumail-gateway
ExecStart=/usr/local/bin/uwumail-gateway serve --config /etc/uwumail-gateway/gateway.toml
Restart=always
RestartSec=2
StateDirectory=uwumail-gateway
StateDirectoryMode=0700
UMask=0077
LimitNOFILE=65536

# Binding the low mail and web ports is the only privilege; everything else stays locked.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target

#!/usr/bin/env bash
# The part of a UwUMail Server installation that needs root. The server itself has none: its
# container is distroless, read-only, unprivileged and has every capability dropped but the one it
# needs for the low ports. It cannot ask apt what is waiting, and it certainly cannot install it.
#
# The two meet in a directory both can see, through plain files:
#
#   machine.json   written here    what apt says, what else runs on this machine, what is deployed
#   jobs.jsonl     written by the server   one job per line, waiting to be carried out
#   job-<id>.log   written here    what the job printed, while it runs
#   job-<id>.json  written here    how it ended, which survives the container being replaced
#   vpn.json       written by the server   the VPN's settings for the next vpn-apply; removed once read
#
# Nothing the server writes is ever run as a command. A job is one verb from a fixed list, and
# nothing else: no command, no path, no address. A server somebody took over can ask for the
# system's updates or a restart, and for nothing more. UwUMail itself is updated by update.sh,
# which a person starts on this machine.
#
# The one job that takes data is the VPN (vpn-apply): the portal hands over the settings of the
# gluetun container in vpn.json, and they end up in .env.vpn next to compose.yaml. Only the
# variables named below get through, only values without quotes or control characters, and an
# OpenVPN file only without the directives that run programs or touch files. The worst a server
# somebody took over can do with it is point its own pictures at a different VPN.
#
# The container can write the shared directory, so it can put a symlink wherever a name is. Nothing
# here therefore touches a name there after creating it: a file is made fresh with its final mode
# and renamed into place (a rename replaces a symlink, it never follows one), and a job's log is
# opened once and written through that descriptor (security-audit-0.5.2 S-12,
# security-audit-0.8.0 INF-3).
#
#   helper machine        write machine.json (slow: asks apt)
#   helper task           carry out the jobs that are waiting
#   helper report         what all of this looks like right now, for people
set -uo pipefail
# The mode everything written into the shared directory has from the moment it exists.
umask 027

# Where this keeps things. Both can be moved for a dry run on a machine one has no root on; the
# systemd units set no environment, and systemd does not pass one in, so in service they are always
# the paths below.
state="${UWUMAIL_HOST_STATE:-/var/lib/uwumail-host}"
bridge="$state/bridge"
config="${UWUMAIL_HOST_CONFIG:-/etc/uwumail-host/host.conf}"
machine_file="$bridge/machine.json"
jobs_file="$bridge/jobs.jsonl"
# What this helper is willing to do at all.
verbs="os-update reboot vpn-apply vpn-stop"
# A job older than this was meant for a different day; the server asks again if it still wants it.
JOB_MAX_AGE=1800
LOG_MAX_BYTES=65536

# COMPOSE_DIR and, if the admin set one, COMPOSE_FILE.
# shellcheck source=/dev/null
[ -f "$config" ] && . "$config"
COMPOSE_DIR="${COMPOSE_DIR:-/opt/uwumail}"
SERVICE="${SERVICE:-uwumail}"
VPN_SERVICE="${VPN_SERVICE:-gluetun}"
vpn_request="$bridge/vpn.json"
VPN_REQUEST_MAX_BYTES=262144
OVPN_MAX_BYTES=65536
VPN_HEALTH_WAIT="${VPN_HEALTH_WAIT:-120}"

# The gluetun variables the portal may set, and the providers gluetun knows.
vpn_keys="VPN_SERVICE_PROVIDER VPN_TYPE WIREGUARD_PRIVATE_KEY WIREGUARD_PRESHARED_KEY WIREGUARD_PUBLIC_KEY
WIREGUARD_ADDRESSES WIREGUARD_ENDPOINT_IP WIREGUARD_ENDPOINT_PORT OPENVPN_USER OPENVPN_PASSWORD SERVER_COUNTRIES
SERVER_REGIONS SERVER_CITIES SERVER_HOSTNAMES"
vpn_providers="airvpn
custom
cyberghost
expressvpn
fastestvpn
giganews
hidemyass
ipvanish
ivpn
mullvad
nordvpn
perfect privacy
privado
private internet access
privatevpn
protonvpn
purevpn
slickvpn
surfshark
torguard
vpn unlimited
vpnsecure
vyprvpn
windscribe"

say() { logger -t uwumail-host "$1"; }

# Filled in by look_around and deployed, which answer in variables rather than a printed line.
found_alone="null"
found_others=""
found_image=""
found_digest=""

compose() {
  ( cd "$COMPOSE_DIR" && docker compose "$@" )
}

# ── what this machine looks like ──────────────────────────────────────────────────────────────
# Whether this is a machine we know how to update at all. Everything else is reported as unknown
# rather than guessed at: a wrong "nothing to do" is worse than an honest "I cannot tell".
os_kind() {
  local id="" like=""
  if [ -r /etc/os-release ]; then
    id=$(. /etc/os-release && printf '%s' "${ID:-}")
    like=$(. /etc/os-release && printf '%s' "${ID_LIKE:-}")
  fi
  case " $id $like " in
    *" debian "* | *" ubuntu "*) command -v apt-get >/dev/null 2>&1 && { printf 'debian'; return; } ;;
  esac
  printf 'unknown'
}

os_name() {
  [ -r /etc/os-release ] && (. /etc/os-release && printf '%s' "${PRETTY_NAME:-${NAME:-}}")
}

# How many packages wait, and how many of those are security updates.
count_updates() {
  if [ -x /usr/lib/update-notifier/apt-check ]; then
    /usr/lib/update-notifier/apt-check 2>&1 | tr ';' ' '
    return
  fi
  local all
  all=$(apt-get -s -o Debug::NoLocking=true dist-upgrade 2>/dev/null | grep -c '^Inst ')
  printf '%s 0' "$all"
}

# Everything here that is not us. A machine that only runs UwUMail can be updated without thinking
# about it; one that also runs a web server or somebody's Nextcloud cannot, because `apt` restarts
# those too and a reboot takes them with it.
#
# The important rule: when this cannot be answered, it says so. A warning that sometimes stays
# quiet is worse than no warning.
# The two below answer in variables rather than in a printed line: a packed line read back with
# `read` loses an empty first field, because a tab counts as whitespace and gets stripped.
look_around() {
  local ours="" others="" alone="null" seen_docker=false
  if command -v docker >/dev/null 2>&1 && docker ps >/dev/null 2>&1; then
    seen_docker=true
    # Our own project by name. `docker compose ls` lists every project on the machine, so picking
    # the first of those would name somebody else's -- and then UwUMail itself looks like the
    # stranger. `compose config` answers for this directory and nothing else.
    ours=$(compose config --format json 2>/dev/null | jq -r '.name // empty' 2>/dev/null)
    if [ -z "$ours" ]; then
      local mine
      mine=$(compose ps -q "$SERVICE" 2>/dev/null | head -1)
      ours=$(docker inspect --format '{{index .Config.Labels "com.docker.compose.project"}}' "$mine" 2>/dev/null)
    fi
    while IFS= read -r project; do
      [ -z "$project" ] && continue
      [ "$project" = "$ours" ] && continue
      others="$others $project"
    done < <(docker ps --format '{{.Label "com.docker.compose.project"}}' 2>/dev/null | sort -u)
    # Containers that belong to no compose project at all still share the machine.
    local loose
    loose=$(docker ps --filter 'label=com.docker.compose.project' --format '{{.ID}}' 2>/dev/null | wc -l)
    local total
    total=$(docker ps --format '{{.ID}}' 2>/dev/null | wc -l)
    [ "$total" -gt "$loose" ] && others="$others docker"
  fi
  command -v podman >/dev/null 2>&1 && [ "$(podman ps -q 2>/dev/null | wc -l)" -gt 0 ] && others="$others podman"
  local service
  for service in postfix exim4 dovecot nginx apache2 httpd caddy lighttpd sw-engine k3s kubelet mysql mariadb \
    postgresql nextcloud-cron; do
    systemctl is-active --quiet "$service" 2>/dev/null && others="$others $service"
  done
  others=$(printf '%s' "$others" | tr ' ' '\n' | grep -v '^$' | sort -u | tr '\n' ' ' | sed 's/ $//')
  if ! $seen_docker; then
    # No way to see the containers means no way to be sure, so the answer stays unknown.
    alone="null"
  elif [ -z "$others" ]; then
    alone="true"
  else
    alone="false"
  fi
  found_alone="$alone"
  found_others="$others"
}

# What is deployed right now, so an update can be told apart from a restart afterwards. The tag
# comes from what compose says it pulled; the id is the image the running container was made from,
# which is the only thing that really tells two builds of the same tag apart.
deployed() {
  local container
  found_image=$(compose images --format json "$SERVICE" 2>/dev/null |
    jq -r 'if type == "array" then .[0] else . end | select(.Repository != null and .Repository != "") | "\(.Repository):\(.Tag)"' 2>/dev/null |
    head -1)
  container=$(compose ps -q "$SERVICE" 2>/dev/null | head -1)
  found_digest=$(docker inspect --format '{{.Image}}' "$container" 2>/dev/null)
  [ -z "$found_image" ] && found_image=$(docker inspect --format '{{.Config.Image}}' "$container" 2>/dev/null)
}

cmd_machine() {
  # Only when it is not there. The installer decides who this belongs to, and re-creating it here
  # with a mode of our own would quietly undo that on the next tick.
  [ -d "$bridge" ] || install -d -m 0770 "$bridge"
  local kind name updates security reboot packages alone others image digest counts
  kind=$(os_kind)
  name=$(os_name)
  updates=0
  security=0
  if [ "$kind" = "debian" ]; then
    apt-get update -qq >/dev/null 2>&1
    counts=$(count_updates)
    updates=${counts%% *}
    security=${counts##* }
  fi
  [[ "$updates" =~ ^[0-9]+$ ]] || updates=0
  [[ "$security" =~ ^[0-9]+$ ]] || security=0
  reboot=false
  [ -f /var/run/reboot-required ] && reboot=true
  packages=""
  [ -f /var/run/reboot-required.pkgs ] && packages=$(sort -u /var/run/reboot-required.pkgs | tr '\n' ' ')
  look_around
  deployed
  alone="$found_alone"
  others="$found_others"
  image="$found_image"
  digest="$found_digest"

  local vpn
  vpn=$(vpn_status)

  local tmp="$machine_file.tmp"
  jq -n \
    --argjson vpn "$vpn" --arg verbs "$verbs" \
    --arg kind "$kind" --arg name "$name" --argjson updates "$updates" --argjson security "$security" \
    --argjson reboot "$reboot" --arg packages "$packages" --argjson alone "$alone" --arg others "$others" \
    --arg image "$image" --arg digest "$digest" --arg dir "$COMPOSE_DIR" \
    --argjson at "$(date +%s)" --arg helper "$(helper_version)" \
    '{kind: $kind, name: $name, updates: $updates, securityUpdates: $security,
      rebootRequired: $reboot, rebootPackages: ($packages | split(" ") | map(select(. != ""))),
      alone: $alone, others: ($others | split(" ") | map(select(. != ""))),
      image: $image, digest: $digest, composeDir: $dir, checkedAt: $at, helper: $helper,
      verbs: ($verbs | split(" ")), vpn: $vpn}' 2>/dev/null |
    safe_write "$tmp" && mv -fT "$tmp" "$machine_file"
}

helper_version() {
  printf '%s' "${UWUMAIL_HOST_HELPER_VERSION:-2}"
}

# ── the VPN for the pictures ──────────────────────────────────────────────────────────────────
# How the gluetun container is doing, as JSON. Never any of its settings but the provider and the
# type: the keys stay in .env.vpn.
vpn_status() {
  local env_file="$COMPOSE_DIR/.env.vpn" configured=false provider="" type="" state="missing" health=""
  local container
  if [ -f "$env_file" ]; then
    configured=true
    provider=$(sed -n "s/^VPN_SERVICE_PROVIDER='\{0,1\}\([^']*\)'\{0,1\}$/\1/p" "$env_file" | tail -1)
    type=$(sed -n "s/^VPN_TYPE='\{0,1\}\([^']*\)'\{0,1\}$/\1/p" "$env_file" | tail -1)
  fi
  if command -v docker >/dev/null 2>&1; then
    container=$(compose ps -a -q "$VPN_SERVICE" 2>/dev/null | head -1)
    if [ -n "$container" ]; then
      state=$(docker inspect --format '{{.State.Status}}' "$container" 2>/dev/null)
      health=$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{end}}' "$container" 2>/dev/null)
    fi
  fi
  jq -cn --argjson configured "$configured" --arg provider "$provider" --arg type "$type" \
    --arg state "${state:-missing}" --arg health "$health" --arg profiles "$(compose_profiles)" \
    '{configured: $configured, provider: $provider, type: $type, state: $state, health: $health,
      always: ($profiles | split(",") | index("vpn") != null)}' 2>/dev/null ||
    printf '{"configured":false,"provider":"","type":"","state":"missing","health":"","always":false}'
}

# Brings only the VPN part of machine.json up to date, without asking apt (which cmd_machine does,
# and which takes a while).
refresh_vpn_status() {
  [ -f "$machine_file" ] && [ ! -L "$machine_file" ] || {
    cmd_machine
    return
  }
  local tmp="$machine_file.tmp" vpn
  vpn=$(vpn_status)
  jq --argjson vpn "$vpn" --arg verbs "$verbs" '.vpn = $vpn | .verbs = ($verbs | split(" "))' "$machine_file" 2>/dev/null |
    safe_write "$tmp" && mv -fT "$tmp" "$machine_file"
}

# COMPOSE_PROFILES in .env, comma-separated.
compose_profiles() {
  [ -f "$COMPOSE_DIR/.env" ] || return 0
  sed -n 's/^COMPOSE_PROFILES=//p' "$COMPOSE_DIR/.env" | tail -1 | tr -d "\"' "
}

# Adds or removes one profile in .env, so the VPN comes along with every `docker compose up -d`
# (update.sh included) or stops doing so. The file keeps its owner and mode.
set_profile() {
  local action="$1" profile="$2" env_file="$COMPOSE_DIR/.env" current next item
  [ -f "$env_file" ] || return 0
  current=$(compose_profiles)
  next=""
  for item in ${current//,/ }; do
    [ "$item" = "$profile" ] && continue
    next="${next:+$next,}$item"
  done
  [ "$action" = add ] && next="${next:+$next,}$profile"
  local tmp="$env_file.uwumail-host.tmp"
  cp -p -- "$env_file" "$tmp" || return 1
  if grep -q '^COMPOSE_PROFILES=' "$tmp"; then
    if [ -n "$next" ]; then
      sed -i "s/^COMPOSE_PROFILES=.*/COMPOSE_PROFILES=$next/" "$tmp"
    else
      sed -i '/^COMPOSE_PROFILES=/d' "$tmp"
    fi
  elif [ -n "$next" ]; then
    printf 'COMPOSE_PROFILES=%s\n' "$next" >>"$tmp"
  fi
  mv -fT "$tmp" "$env_file"
}

# Reads vpn.json out of the shared directory and removes it: it holds the VPN's keys. The name is
# opened once and the descriptor checked to be that very file, so a symlink the other side swaps in
# can't make root read something else.
take_vpn_request() {
  [ -f "$vpn_request" ] && [ ! -L "$vpn_request" ] || return 1
  exec 4<"$vpn_request" || return 1
  if [ "$(readlink "/proc/$BASHPID/fd/4")" != "$vpn_request" ]; then
    exec 4<&-
    return 1
  fi
  head -c "$VPN_REQUEST_MAX_BYTES" <&4
  exec 4<&-
  rm -f -- "$vpn_request"
}

# Whether an OpenVPN file is only a connection: nothing that runs a program, loads a plugin, or
# reads or writes a file of its own choosing.
ovpn_is_harmless() {
  ! grep -Eiq '^[[:space:]]*-{0,2}((up|down|route-up|route-pre-down|ipchange|client-connect|client-disconnect|learn-address|auth-user-pass-verify|tls-verify|script-security|plugin|management[a-z-]*|log|log-append|status|writepid|cd|chroot|daemon|config|askpass|tmp-dir|iproute|tls-crypt-v2-verify|tls-export-cert|setenv|setenv-safe|pull-filter|dhcp-option)([[:space:]]|$)|auth-user-pass[[:space:]]+[^[:space:]#;])'
}

# Turns the request into .env.vpn lines on standard output, or says what is wrong and fails.
vpn_env_lines() {
  local request="$1" key value
  local keys
  keys=$(printf '%s' "$request" | jq -r '.env | if type == "object" then keys[] else error("no env") end' 2>/dev/null) || {
    echo "the settings are not readable" >&2
    return 1
  }
  for key in $keys; do
    case " $(printf '%s' "$vpn_keys" | tr '\n' ' ') " in *" $key "*) ;; *)
      echo "$key is not a setting this helper passes on" >&2
      return 1
      ;;
    esac
    value=$(printf '%s' "$request" | jq -r --arg key "$key" '.env[$key] | if type == "string" then . else error("x") end' 2>/dev/null) || {
      echo "$key is not text" >&2
      return 1
    }
    if [ "${#value}" -gt 1024 ] || [[ "$value" == *"'"* ]] || [[ "$value" =~ [[:cntrl:]] ]]; then
      echo "$key has a value this helper does not pass on" >&2
      return 1
    fi
    case "$key" in
      VPN_SERVICE_PROVIDER)
        printf '%s\n' "$vpn_providers" | grep -Fxq -- "$value" || {
          echo "gluetun does not know the provider $value" >&2
          return 1
        }
        ;;
      VPN_TYPE)
        [[ "$value" =~ ^(wireguard|openvpn)$ ]] || {
          echo "VPN_TYPE is wireguard or openvpn" >&2
          return 1
        }
        ;;
    esac
    printf "%s='%s'\n" "$key" "$value"
  done
}

do_vpn_apply() {
  local id="$1" request lines ovpn env_file="$COMPOSE_DIR/.env.vpn"
  if ! request=$(take_vpn_request); then
    job_state "$id" failed "the portal did not hand over the VPN settings"
    return 1
  fi
  if ! lines=$(vpn_env_lines "$request" 2>&1); then
    printf '%s\n' "$lines" | job_log "$id"
    job_state "$id" failed "$lines"
    return 1
  fi
  ovpn=$(printf '%s' "$request" | jq -r '.ovpn // empty' 2>/dev/null)
  if [ -n "$ovpn" ]; then
    if [ "${#ovpn}" -gt "$OVPN_MAX_BYTES" ] || ! printf '%s\n' "$ovpn" | ovpn_is_harmless; then
      job_state "$id" failed "the OpenVPN file asks for more than a connection (scripts, plugins or files)"
      return 1
    fi
    install -d -m 0700 "$COMPOSE_DIR/vpn"
    printf '%s\n' "$ovpn" | safe_write "$COMPOSE_DIR/vpn/custom.ovpn.tmp" &&
      chmod 0600 "$COMPOSE_DIR/vpn/custom.ovpn.tmp" &&
      mv -fT "$COMPOSE_DIR/vpn/custom.ovpn.tmp" "$COMPOSE_DIR/vpn/custom.ovpn"
    lines="$lines"$'\n'"OPENVPN_CUSTOM_CONFIG='/gluetun/custom/custom.ovpn'"
  fi
  {
    printf '# Written by the UwUMail portal (Settings -> VPN). Changes here are replaced the next time\n'
    printf '# the VPN is saved there.\n'
    printf '%s\n' "$lines"
  } | (umask 077 && safe_write "$env_file.tmp") && chmod 0600 "$env_file.tmp" && mv -fT "$env_file.tmp" "$env_file"
  set_profile add vpn
  {
    printf '== docker compose --profile vpn up -d %s\n' "$VPN_SERVICE"
    compose --profile vpn up -d --force-recreate "$VPN_SERVICE"
  } 2>&1 | job_log "$id"
  if [ "${PIPESTATUS[0]}" -ne 0 ]; then
    refresh_vpn_status
    job_state "$id" failed "the VPN container did not start"
    return 1
  fi
  local waited=0 container health
  container=$(compose ps -q "$VPN_SERVICE" 2>/dev/null | head -1)
  while [ "$waited" -lt "$VPN_HEALTH_WAIT" ]; do
    health=$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{end}}' "$container" 2>/dev/null)
    [ "$health" = healthy ] && break
    sleep 5
    waited=$((waited + 5))
  done
  refresh_vpn_status
  if [ "$health" = healthy ]; then
    printf '\n== the VPN is up\n' | job_log "$id"
    job_state "$id" "done"
  else
    {
      printf '\n== the VPN did not come up in %s seconds; its last words:\n' "$VPN_HEALTH_WAIT"
      docker logs --tail 40 "$container" 2>&1
    } | job_log "$id"
    job_state "$id" failed "the VPN did not connect; its log is below"
  fi
}

do_vpn_stop() {
  local id="$1"
  set_profile remove vpn
  {
    printf '== docker compose stop %s\n' "$VPN_SERVICE"
    compose --profile vpn stop "$VPN_SERVICE"
    compose --profile vpn rm -f "$VPN_SERVICE"
  } 2>&1 | job_log "$id"
  refresh_vpn_status
  job_state "$id" "done"
}

# Writes standard input to a file without following a symlink the other side may have planted in the
# shared directory. The name is cleared first (removing a symlink, not its target), then opened with
# noclobber (O_EXCL), so a symlink re-planted in the meantime makes the write fail rather than reach
# through it to an arbitrary host file (security-audit-0.5.2 S-12).
safe_write() {
  local target="$1"
  rm -f -- "$target"
  ( set -C; cat >"$target" )
}

# ── the jobs the server may ask for ───────────────────────────────────────────────────────────
job_state() {
  local id="$1" state="$2" error="${3:-}"
  jq -n --arg id "$id" --arg state "$state" --arg error "$error" --argjson at "$(date +%s)" \
    '{id: $id, state: $state, error: $error, at: $at}' 2>/dev/null | safe_write "$bridge/job-$id.json.tmp" &&
    mv -fT "$bridge/job-$id.json.tmp" "$bridge/job-$id.json"
}

# Everything a job prints goes here, capped, so the portal can show it while it runs. The log is
# opened once, by run_job, and only ever written through that descriptor (3), never by its name.
job_log() {
  tail -c "$LOG_MAX_BYTES" >&3
}

# Carries out one job with its log open on descriptor 3: made fresh with noclobber, so a name
# re-planted after the rm makes the job fail rather than write through it.
run_job() {
  local id="$1" verb="$2"
  local log="$bridge/job-$id.log" started=false
  rm -f -- "$log"
  set -C
  {
    set +C
    started=true
    case "$verb" in
      os-update) do_os_update "$id" ;;
      reboot) do_reboot "$id" ;;
      vpn-apply) do_vpn_apply "$id" ;;
      vpn-stop) do_vpn_stop "$id" ;;
    esac
  } 3>"$log"
  set +C
  $started || job_state "$id" failed "the job's log could not be started"
}

# apt, with every question answered the way the package maintainer meant it. NEEDRESTART_MODE=a
# matters on Ubuntu 24.04 and newer: without it the run stops on a full-screen question nobody is
# there to answer.
run_apt() {
  DEBIAN_FRONTEND=noninteractive \
    NEEDRESTART_MODE=a \
    APT_LISTCHANGES_FRONTEND=none \
    apt-get -y \
    -o Dpkg::Options::=--force-confdef \
    -o Dpkg::Options::=--force-confold \
    -o DPkg::Lock::Timeout=300 \
    "$@"
}

do_os_update() {
  local id="$1"
  [ "$(os_kind)" = "debian" ] || {
    job_state "$id" failed "this machine is not one apt can update"
    return 1
  }
  {
    printf '== apt-get update\n'
    run_apt update
    printf '\n== apt-get dist-upgrade\n'
    run_apt dist-upgrade
    printf '\n== apt-get autoremove\n'
    run_apt --purge autoremove
  } 2>&1 | job_log "$id"
  local result=${PIPESTATUS[0]}
  cmd_machine
  if [ "$result" -eq 0 ]; then
    job_state "$id" "done"
  else
    job_state "$id" failed "apt ended with $result"
  fi
}

do_reboot() {
  local id="$1"
  job_state "$id" "done"
  printf 'the machine restarts in a minute\n' | job_log "$id"
  say "restarting on request from the portal"
  # A minute, so the answer to the request still gets out and mail in flight has a moment.
  shutdown -r +1 "UwUMail: update" >/dev/null 2>&1 &
}

cmd_task() {
  [ -s "$jobs_file" ] || return 0
  local waiting="$jobs_file.now"
  mv -fT "$jobs_file" "$waiting" 2>/dev/null || return 0

  local line id verb asked now
  now=$(date +%s)
  while IFS= read -r line; do
    id=$(printf '%s' "$line" | jq -r '.id // empty' 2>/dev/null)
    verb=$(printf '%s' "$line" | jq -r '.verb // empty' 2>/dev/null)
    asked=$(printf '%s' "$line" | jq -r '.at // 0' 2>/dev/null)
    # An id names a file, so it may be nothing but letters and digits.
    [[ "$id" =~ ^[A-Za-z0-9]{4,40}$ ]] || continue
    case " $verbs " in *" $verb "*) ;; *)
      job_state "$id" failed "this helper does not do $verb"
      continue
      ;;
    esac
    [[ "$asked" =~ ^[0-9]{1,12}$ ]] || asked=0
    if [ "$asked" -gt 0 ] && [ $((now - asked)) -gt "$JOB_MAX_AGE" ]; then
      job_state "$id" failed "the job waited too long; ask again"
      continue
    fi
    [ -e "$bridge/job-$id.json" ] && continue # already done, or being done

    say "carrying out $verb (job $id)"
    job_state "$id" running
    run_job "$id" "$verb"
  done <"$waiting"
  rm -f "$waiting"

  # Jobs nobody will ask about again.
  find "$bridge" -maxdepth 1 -name 'job-*' -mtime +7 -delete 2>/dev/null
}

cmd_report() {
  if [ ! -f "$machine_file" ]; then
    echo "nothing has been written down yet; run: $0 machine"
    return 0
  fi
  jq -r '
    "UwUMail host, seen \(.checkedAt | todate)",
    "  system     \(.name) (\(.kind))",
    "  updates    \(.updates) waiting, \(.securityUpdates) of them security",
    "  restart    \(if .rebootRequired then "needed" else "not needed" end)",
    "  alone      \(if .alone == true then "yes" elif .alone == false then "no: " + (.others | join(", ")) else "cannot tell" end)",
    "  deployed   \(.image) \(.digest)"
  ' "$machine_file"
}

# Sourced by deploy/tests/helpers.sh, which calls the functions above on a directory of its own.
[ "${BASH_SOURCE[0]}" = "$0" ] || return 0

case "${1:-}" in
  machine) cmd_machine ;;
  task) cmd_task ;;
  report) cmd_report ;;
  *)
    sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//'
    exit 2
    ;;
esac
